{
  "name": "Refka",
  "short_name": "Refka",
  "description": "Your gym's own app: membership, check-in QR and the people you train with.",
  "id": "/app/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0B0B0C",
  "theme_color": "#0B0B0C",
  "dir": "auto",
  "categories": ["fitness", "health"],
  "icons": [
    { "src": "../assets/icons/refka-icon.svg", "type": "image/svg+xml", "sizes": "any" },
    { "src": "../assets/icons/refka-icon-192.png", "type": "image/png", "sizes": "192x192", "purpose": "any" },
    { "src": "../assets/icons/refka-icon-512.png", "type": "image/png", "sizes": "512x512", "purpose": "any" },
    { "src": "../assets/icons/icon-512-maskable.png", "type": "image/png", "sizes": "512x512", "purpose": "maskable" }
  ]
}
